  extension_connections ||--o{ jobs : "extension_id"
  projects ||--o{ credit_ledger : "project_id"
  jobs ||--o{ credit_ledger : "job_id"
  projects ||--o{ publications : "project_id"
  publications ||--o{ video_metrics : "publication_id"
  projects ||--o{ policy_checks : "project_id"
  projects ||--o{ affiliate_links : "project_id"
  accounts ||--o{ bio_pages : "account_id"
  bio_pages ||--o{ bio_items : "bio_page_id"
