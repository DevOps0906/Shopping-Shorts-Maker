erDiagram
  categories {
    uuid id PK
    text name
    text__ keywords_ko
    text__ keywords_en
    text__ keywords_zh
    text__ banned_terms
  }
  trend_items {
    uuid id PK
    uuid category_id FK
    text name
    text period
    numeric overseas_growth
    numeric kr_search_growth
    numeric kr_competition
    numeric opportunity_score
    boolean sellable
    timestamptz captured_at
  }
  user_profiles {
    uuid user_id PK,FK
    text name
    text email
    text default_tone
    text default_lang
    text subtitle_style
    smallint default_len
    boolean notify_done
    boolean notify_weekly
  }
  accounts {
    uuid id PK
    uuid user_id FK
    uuid category_id FK
    text platform
    text channel_name
    text tone
    text target
    integer weekly_goal
    boolean is_default
    uuid oauth_token_ref
    text status
    timestamptz created_at
  }
  projects {
    uuid id PK
    uuid user_id FK
    uuid category_id FK
    uuid account_id
    text name
    smallint current_step
    jsonb step_status
    text status
    smallint target_sec
    timestamptz created_at
    timestamptz updated_at
  }
  project_events {
    uuid id PK
    uuid project_id FK
    smallint step
    text event
    timestamptz created_at
  }
  topics {
    uuid id PK
    uuid project_id FK
    integer round
    text name
    text reason
    text__ evidence_urls
    boolean picked
    timestamptz created_at
  }
  sources {
    uuid id PK
    uuid project_id FK
    uuid rights_confirmed_by FK
    text platform
    text url
    text author
    text title
    timestamptz collected_at
    integer width
    integer height
    numeric duration_sec
    numeric score
    string more_7_cols
  }
  scripts {
    uuid id PK
    uuid project_id FK
    integer version
    jsonb lines
    numeric est_sec
    timestamptz approved_at
    timestamptz created_at
  }
  voice_takes {
    uuid id PK
    uuid project_id FK
    text voice_id
    text source
    text audio_path
    jsonb words
    jsonb pauses
    numeric duration_sec
    timestamptz created_at
  }
  renders {
    uuid id PK
    uuid project_id FK
    integer version
    jsonb cut_map
    text upscale_status
    text clean_status
    text mp4_path
    timestamptz created_at
  }
  chat_messages {
    uuid id PK
    uuid project_id FK
    text role
    text kind
    text text
    jsonb payload
    timestamptz created_at
  }
  extension_connections {
    uuid id PK
    uuid user_id FK
    text access_token_hash
    timestamptz access_expires_at
    text refresh_token_hash
    timestamptz refresh_expires_at
    uuid family_id
    timestamptz last_heartbeat_at
    timestamptz revoked_at
    timestamptz created_at
  }
  jobs {
    uuid id PK
    uuid project_id FK
    uuid extension_id FK
    smallint step
    text type
    text status
    text idempotency_key
    integer attempts
    integer max_attempts
    jsonb payload
    text error
    timestamptz started_at
    string more_2_cols
  }
  credit_ledger {
    uuid id PK
    uuid user_id FK
    uuid project_id FK
    uuid job_id FK
    text kind
    integer delta
    text reason
    text idempotency_key
    timestamptz created_at
  }
  publications {
    uuid id PK
    uuid project_id
    uuid account_id
    text mode
    timestamptz scheduled_at
    timestamptz published_at
    text platform_video_id
    text status
    text error
    integer retry_count
    timestamptz created_at
  }
  video_metrics {
    uuid id PK
    uuid publication_id FK
    date date
    integer views
    integer link_clicks
    numeric avg_view_pct
    integer est_revenue
  }
  policy_checks {
    uuid id PK
    uuid project_id FK
    text item
    text result
    text detail
  }
  affiliate_links {
    uuid id PK
    uuid project_id FK
    text program
    text url
    text short_url
    text partner_id_ref
    boolean disclosed
    text bio_service
    integer bio_no
    timestamptz bio_registered_at
    timestamptz created_at
  }
  bio_pages {
    uuid id PK
    uuid account_id FK
    text service
    text url
    timestamptz created_at
  }
  bio_items {
    uuid id PK
    uuid bio_page_id FK
    uuid project_id FK
    uuid affiliate_link_id FK
    integer no
    text short_url
    text title
    text thumb_url
    timestamptz registered_at
    timestamptz archived_at
  }
  link_clicks {
    uuid id PK
    uuid affiliate_link_id FK
    text short_url
    timestamptz clicked_at
    text referrer
    text platform
  }
  api_keys {
    uuid id PK
    uuid user_id FK
    text provider
    uuid secret_ref
    text last4
    text status
    timestamptz tested_at
    timestamptz created_at
  }
  categories ||--o{ trend_items : "category_id"
